# Servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=JARVIS

# IA conversacional opcional y compatible con OpenAI, Groq u OpenRouter
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_TIMEOUT_MS=60000

# Búsqueda web: se utiliza para ampliar respuestas o cuando la IA no está configurada
SEARCH_TIMEOUT_MS=15000

# Firebase Admin / Firestore (opcional en desarrollo)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Copia la clave privada con los saltos de línea escapados como \\n+FIREBASE_PRIVATE_KEY=

# Clave privada para AES-256-GCM. Usa una cadena aleatoria larga y NO la publiques.
MEMORY_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Seguridad futura
AUTH_MODE=development
DEFAULT_USER_ID=default

# Sandbox de archivos controlados
FILE_SANDBOX_DIR=./storage/sandbox
