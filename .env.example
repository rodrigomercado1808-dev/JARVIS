# Servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=JARVIS

# Cerebro neuronal JavaScript con pesos versionados en brain/weights.json
BRAIN_WEIGHTS_PATH=./brain/weights.json
SEARCH_TIMEOUT_MS=15000

# Firebase Admin / Firestore (servidor; nunca publiques estos secretos)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Copia la clave privada con los saltos de línea escapados como \\nFIREBASE_PRIVATE_KEY=

# Firebase Web Auth (configuración pública de la aplicación web)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# Memoria cifrada en Firestore
MEMORY_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Modo development permite chat sin login usando sessionStorage
AUTH_MODE=development
DEFAULT_USER_ID=default
FILE_SANDBOX_DIR=./storage/sandbox
